APP_ENV=local
LOG_LEVEL=INFO

# Пороги приоритета (формат списка JSON). Эти значения совпадают с таблицей по умолчанию.
PRIORITY_AGE_THRESHOLDS_HOURS=[24,72,168]
PRIORITY_SENDER_THRESHOLDS=[3,6,11]

# Радиус поиска похожих проблем, метры
MERGE_RADIUS_M=30

# Сколько последних фотографий хранится по одной проблеме
MAX_PHOTOS_PER_PROBLEM=10

# Фотографии: максимальный размер файла (байты), максимум пикселей, длинная сторона
# сохраняемого фото и превью, качество JPEG
MAX_UPLOAD_BYTES=10000000
MAX_IMAGE_PIXELS=40000000
PHOTO_MAX_SIDE=1600
THUMB_MAX_SIDE=400
JPEG_QUALITY=85

# Секреты. ВСЕ значения ниже фиктивные. Настоящие значения хранятся только в файле .env,
# который не попадает в Git.
TELEGRAM_BOT_TOKEN=123456789:EXAMPLE-not-a-real-token
SENDER_HMAC_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_KEY=example-not-a-real-key
SUPABASE_STORAGE_BUCKET=problem-photos
