APP_ENV=local
LOG_LEVEL=INFO

# Пороги приоритета (формат списка JSON). Эти значения совпадают с таблицей по умолчанию.
PRIORITY_AGE_THRESHOLDS_HOURS=[24,72,168]
PRIORITY_SENDER_THRESHOLDS=[3,6,11]

# Радиус поиска похожих проблем, метры
MERGE_RADIUS_M=30

# Понадобятся на следующих этапах:
TELEGRAM_BOT_TOKEN=123456789:EXAMPLE-not-a-real-token
SENDER_HMAC_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/true_alarm
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_KEY=example-not-a-real-key